# LinaresYa - variables de entorno
# Copia este archivo como .env.local y rellena con tus valores reales.
# .env.local NO se sube al repo (ya esta en .gitignore).

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_TU-CLAVE

# Secret key - SOLO en servidor / CI. Tiene privilegios elevados y nunca debe
# llevar prefijo NEXT_PUBLIC_ ni aparecer en el navegador o en el repositorio.
SUPABASE_SECRET_KEY=sb_secret_TU-CLAVE

# Password del panel administrador (/admin). Usa una clave larga y unica.
ADMIN_PASSWORD=pon-aqui-una-clave-larga-y-unica

# URL canonica del sitio (sin slash al final). Usada en sitemap, robots y OG.
NEXT_PUBLIC_SITE_URL=https://linaresya.vercel.app

# Cloudflare Turnstile (captcha para /publicar).
# Dejar vacias desactiva el captcha (util para dev local).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0xPON-AQUI-TU-SITE-KEY
TURNSTILE_SECRET_KEY=0xPON-AQUI-TU-SECRET-KEY

# Resend (emails transaccionales).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_EMAIL=tu-correo@example.com
# RESEND_FROM=LinaresYa <avisos@linaresya.cl>

# Google Analytics 4 (opcional).
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Data Auditor (solo lectura). El auditor permanece privado; solo se consume
# el feed JSON publicado en Vercel.
# DATA_AUDITOR_FINDINGS_URL=https://linaresya-quality-feed.vercel.app/linaresya-quality-findings.json
